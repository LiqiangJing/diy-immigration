# 服务器上的 /srv/diy-immigration/.env.local。改完后执行：sudo systemctl restart diy-immigration

# 数据库存放位置（在代码目录之外，重新部署不会影响）
DATA_DIR=/var/lib/diy-immigration
# 网站对外地址，用于支付完成后跳转回来
APP_URL=https://diyimmigration.space

# Claude API Key（https://platform.claude.com）。服务器上没有 Claude Code 登录，不填聊天无法使用
ANTHROPIC_API_KEY=

# OpenAlex 学术数据接口的 Key（可选，免费申请）
OPENALEX_API_KEY=
# Semantic Scholar 的 Key（可选）：不填走公共通道，高峰时偶尔会被限流
S2_API_KEY=

# 登录验证码邮件。不填时验证码会直接显示在登录页上，只能用于测试
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Stripe 充值。Webhook 地址：<APP_URL>/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CREDIT_MARKUP=40

# 支付宝直连。沙箱测试：到 open.alipay.com 的「沙箱」页面拿应用 ID 和密钥，网关用下面这个沙箱地址
ALIPAY_APP_ID=
# 应用私钥（一整行，不带 BEGIN/END；用「非 Java 语言」格式即 PKCS1，Java 格式则把 ALIPAY_KEY_TYPE 设为 PKCS8）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（注意不是应用公钥）
ALIPAY_PUBLIC_KEY=
# 沙箱网关；正式上线时删掉这一行
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_KEY_TYPE=PKCS1

# 「联系我们」的留言发到这个邮箱（需要同时配置上面的 SMTP）。不填时留言只存在数据库里
CONTACT_EMAIL=

# 用 OpenAI 兼容的模型（官方 API 或 Azure 上的部署）。配了 GPT_API_KEY 就优先用它
GPT_API_KEY=
# Azure 的部署填它给的地址，例如 https://<资源名>.services.ai.azure.com/openai/v1；用 OpenAI 官方 API 时留空
GPT_BASE_URL=
GPT_MODEL=gpt-6.2-sol
# 可选：强制指定通道 openai / anthropic / cli
LLM_PROVIDER=

# 每天（北京时间 0 点重置）前多少个新注册用户有赠送 credit，默认 100
# SIGNUP_DAILY_LIMIT=100

# 重要引用分析的加价倍数，默认 25（比聊天的低）
# NOTABLE_MARKUP=25
