# 复制为 .env.local 并填入你的 Claude API Key（https://platform.claude.com）
ANTHROPIC_API_KEY=

# 可选：OpenAlex 学术数据接口的 Key（https://openalex.org/settings/api）。不填也能用，但每天免费额度很小
OPENALEX_API_KEY=

# 登录验证码邮件（SMTP）。不配置时验证码会直接显示在登录页上，只能用于本地测试
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Stripe 充值（信用卡 + 支付宝）。Webhook 地址填 https://你的域名/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 网站对外地址，用于支付完成后跳转回来，例如 https://example.com
APP_URL=
# 聊天扣费的加价倍数（成本 × 倍数），默认 40
CREDIT_MARKUP=40

# 支付宝直连。沙箱测试：到 open.alipay.com 的「沙箱」页面拿应用 ID 和密钥，网关用下面这个沙箱地址
ALIPAY_APP_ID=
# 应用私钥（一整行，不带 BEGIN/END；用「非 Java 语言」格式即 PKCS1，Java 格式则把 ALIPAY_KEY_TYPE 设为 PKCS8）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（注意不是应用公钥）
ALIPAY_PUBLIC_KEY=
# 沙箱网关；正式上线时删掉这一行
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_KEY_TYPE=PKCS1

# 「联系我们」的留言发到这个邮箱（需要同时配置上面的 SMTP）。不填时留言只存在数据库里
CONTACT_EMAIL=

# 用 OpenAI 兼容的模型（官方 API 或 Azure 上的部署）。配了 GPT_API_KEY 就优先用它
GPT_API_KEY=
# Azure 的部署填它给的地址，例如 https://<资源名>.services.ai.azure.com/openai/v1；用 OpenAI 官方 API 时留空
GPT_BASE_URL=
GPT_MODEL=gpt-6.2-sol
# 可选：强制指定通道 openai / anthropic / cli
LLM_PROVIDER=
