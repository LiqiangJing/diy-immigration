# 复制为 .env.local 并填入你的 Claude API Key（https://platform.claude.com）
ANTHROPIC_API_KEY=

# 可选：OpenAlex 学术数据接口的 Key（https://openalex.org/settings/api）。不填也能用，但每天免费额度很小
OPENALEX_API_KEY=

# 登录验证码邮件（SMTP）。不配置时验证码会直接显示在登录页上，只能用于本地测试
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Stripe 充值（信用卡 + 支付宝）。Webhook 地址填 https://你的域名/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 网站对外地址，用于支付完成后跳转回来，例如 https://example.com
APP_URL=
# 聊天扣费的加价倍数（成本 × 倍数），默认 2
CREDIT_MARKUP=2
